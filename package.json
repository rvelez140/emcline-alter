{
  "name": "rvmail",
  "version": "0.2.0",
  "private": true,
  "description": "RV Mail — correo multi-cuenta autoalojable (Soluciones RV). Backend en Rust (crates/), web en apps/web.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @rvmail/web dev",
    "build": "pnpm --filter @rvmail/web build",
    "typecheck": "pnpm --filter @rvmail/web typecheck",
    "lint": "pnpm --filter @rvmail/web typecheck && prettier --check \"apps/web/src/**/*.{ts,tsx,css}\"",
    "db:migrate": "cargo run -q -p rvmail -- migrate",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
