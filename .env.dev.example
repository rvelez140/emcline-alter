# Desarrollo local (scripts/dev-setup.sh lo copia a .env.dev y genera las claves)
DATABASE_URL=postgres://rvmail:rvmail@localhost:5432/rvmail
REDIS_URL=redis://localhost:6379
JWT_SECRET=__GENERATE__
MASTER_KEY=__GENERATE__
NODE_ENV=development
ALLOW_SIGNUP=true
APP_URL=http://localhost:5173
LOG_LEVEL=debug
SYNC_DAYS=90
SYNC_INTERVAL_SEC=60

# Servidor de correo integrado: en desarrollo, GreenMail hace de servidor y
# scripts/fake-aapanel.mjs simula la API del Mail Server de aaPanel.
#   node scripts/fake-aapanel.mjs   (escucha en :7800, clave "dev-key")
MAILSERVER_PROVIDER=none
MAILSERVER_HOSTNAME=localhost
MAILSERVER_IMAP_PORT=3143
MAILSERVER_SMTP_PORT=3025
AAPANEL_URL=http://localhost:7800
AAPANEL_API_KEY=dev-key
AGENT_SEND_LIMIT_PER_HOUR=30
