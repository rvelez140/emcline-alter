# RV Mail — configuración de producción.
# `rvmail install` (o scripts/install.sh) copia este archivo a .env y genera los secretos.
# Para cambiar ajustes después: `rvmail config`.
# Variables marcadas como (secreto) NUNCA deben compartirse ni subirse a git.

# ---------------------------------------------------------------- dominio y proxy
DOMAIN=correo.example.com
# caddy (Caddy gestiona TLS en 80/443) | external (aaPanel/nginx ya usa 80/443)
PROXY_MODE=external
COMPOSE_PROFILES=
ACME_EMAIL=
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
TZ=America/Santo_Domingo

# Red interna de Docker. La API sale hacia el panel con API_IP: añádela a la
# lista blanca de aaPanel (Settings → API interface → IP whitelist).
DOCKER_SUBNET=172.30.57.0/24
API_IP=172.30.57.10

# ---------------------------------------------------------------- rol del servidor
# primary (servidor principal) | standby (respaldo, p. ej. un VPS ARM de Oracle)
RVMAIL_ROLE=primary
# Dominio de correo principal (Stalwart); vacío = el de MAILSERVER_HOSTNAME sin "mail."
RVMAIL_MAIL_DOMAIN=

# ---------------------------------------------------------------- alta disponibilidad (rvmail ha)
# Las rellena `rvmail ha init` (principal) y `rvmail ha join` (respaldo). Guía: docs/HA.md
RVMAIL_HA=false
# COMPOSE_FILE=docker-compose.yml:docker-compose.ha.yml
# IP privada (WireGuard u otra red privada) donde Postgres acepta la réplica
PG_REPLICATION_BIND=
PG_REPLICATION_PORT=5433
# (secreto) contraseña del rol "replicator"
PG_REPLICATION_PASSWORD=
# WAL máximo retenido para el respaldo
PG_MAX_SLOT_WAL=2GB

# ---------------------------------------------------------------- respaldos fuera del servidor (restic)
# Repositorio S3 compatible, p. ej. Oracle Object Storage:
#   s3:https://<namespace>.compat.objectstorage.<región>.oraclecloud.com/<bucket>
# Vacío = solo respaldos locales en backups/
RESTIC_REPOSITORY=
# (secreto) clave de cifrado del repositorio. SI SE PIERDE, no se pueden leer los respaldos.
RESTIC_PASSWORD=
# (secreto) Customer Secret Key de Oracle / clave de acceso S3
RESTIC_S3_ACCESS_KEY=
RESTIC_S3_SECRET_KEY=
# Región S3 (Oracle: la de tu tenancy, p. ej. us-ashburn-1)
RESTIC_S3_REGION=
# Retención: diarios, semanales, mensuales
RESTIC_KEEP=7,4,6

# ---------------------------------------------------------------- imágenes
# Imágenes precompiladas multi-arquitectura (amd64/arm64) publicadas por CI.
# Déjalo en "rvmail" para compilar localmente en el VPS.
IMAGE_PREFIX=rvmail
APP_VERSION=latest

# ---------------------------------------------------------------- secretos (generados por el instalador)
POSTGRES_USER=rvmail
POSTGRES_DB=rvmail
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# 32 bytes en base64. Cifra las contraseñas de los buzones. SI SE PIERDE, se pierden las credenciales.
MASTER_KEY=

# ---------------------------------------------------------------- aplicación
ALLOW_SIGNUP=false
SESSION_DAYS=30
INSECURE_COOKIES=false
IMAP_ALLOW_SELF_SIGNED=false
LOG_LEVEL=info

# ---------------------------------------------------------------- sincronización (worker)
SYNC_DAYS=90
SYNC_INTERVAL_SEC=300
WORKER_MAX_ACCOUNTS=500

# ---------------------------------------------------------------- servidor de correo integrado
# none     → RV Mail funciona solo como cliente (cuentas IMAP/SMTP/JMAP de cualquier proveedor)
# aapanel  → además administra dominios y buzones del Mail Server de aaPanel del mismo VPS
# stalwart → administra el servidor Stalwart (perfil "stalwart" de compose; JMAP nativo)
MAILSERVER_PROVIDER=none
# Nombre público del servidor de correo (el del certificado TLS de Dovecot/Postfix).
# Dentro de los contenedores se resuelve a la IP del host (sin pasar por internet).
MAILSERVER_HOSTNAME=
MAILSERVER_IMAP_PORT=993
MAILSERVER_SMTP_PORT=465
# URL del panel visto desde los contenedores. host.docker.internal = el propio VPS.
# Incluye el puerto del panel (ver /www/server/panel/data/port.pl).
AAPANEL_URL=https://host.docker.internal:7800
# (secreto) aaPanel → Settings → API interface → clave de la interfaz
AAPANEL_API_KEY=
# El panel suele usar un certificado autofirmado
AAPANEL_VERIFY_TLS=false

# Stalwart (MAILSERVER_PROVIDER=stalwart). Añade "stalwart" a COMPOSE_PROFILES para levantarlo aquí.
STALWART_VERSION=latest
STALWART_URL=http://stalwart:8080
# (secreto) Administrador de recuperación, solo para la configuración inicial
STALWART_RECOVERY_PASSWORD=
# Administrador permanente que crea la configuración inicial (rvmail install lo rellena)
STALWART_ADMIN_USER=
# (secreto)
STALWART_ADMIN_PASSWORD=
STALWART_HTTP_PORT=8180
STALWART_MEM_LIMIT=512m
# URL JMAP para los buzones (vacío = STALWART_URL)
MAILSERVER_JMAP_URL=

# ---------------------------------------------------------------- inicio de sesión con Google / Microsoft / Yahoo
# Registra una app en cada proveedor (guía: docs/SSO.md). URL de retorno:
#   https://<DOMAIN>/api/auth/sso/<google|microsoft|yahoo>/callback
# Vacío = el botón de ese proveedor no aparece.
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
# common (cualquier cuenta), organizations, consumers o el ID de tu inquilino de Entra ID
SSO_MICROSOFT_TENANT=common
SSO_YAHOO_CLIENT_ID=
SSO_YAHOO_CLIENT_SECRET=
# true = crea el usuario de RV Mail la primera vez que alguien entra con SSO
SSO_AUTO_SIGNUP=false

# ---------------------------------------------------------------- apps de escritorio y móvil
# Orígenes con CORS (solo tokens Bearer, nunca cookies). Por defecto, las apps Tauri.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# ---------------------------------------------------------------- agentes de IA (MCP)
# Envíos máximos por hora para cada token de agente (protege tu reputación de envío)
AGENT_SEND_LIMIT_PER_HOUR=30

# ---------------------------------------------------------------- recursos (VPS pequeños / ARM)
# Límites de memoria por servicio. Valores pensados para un VPS de 1–2 GB;
# súbelos en el servidor principal.
APP_MEM_LIMIT=256m
WORKER_MEM_LIMIT=256m
PG_MEM_LIMIT=768m
REDIS_MEM_LIMIT=320m
REDIS_MAXMEMORY=256mb
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE=384MB
PG_MAX_CONNECTIONS=50
