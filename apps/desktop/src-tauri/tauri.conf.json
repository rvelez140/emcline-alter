{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RV Mail",
  "version": "0.2.0",
  "identifier": "net.solucionesrv.rvmail",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Correo multi-cuenta de Soluciones RV",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rvmail", "mailto"]
      }
    }
  }
}
